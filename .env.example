# Local PostgreSQL configuration.
TUTORPULSE_DB_HOST=localhost
TUTORPULSE_DB_PORT=5432
TUTORPULSE_DB_NAME=tutorpulse
TUTORPULSE_DB_USER=postgres
TUTORPULSE_DB_PASSWORD=replace-with-your-local-postgres-password

# Hosted deployments can use one complete PostgreSQL connection
# string instead of the split settings above.
#
# Keep the real connection string outside Git.
# TUTORPULSE_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Local development remains writable by default.
# The public Stage 8 portfolio deployment will set this to true.
TUTORPULSE_DEMO_READ_ONLY=false

# Trusted Stage 7 model artifact location.
TUTORPULSE_MODEL_ARTIFACT_DIRECTORY=artifacts/models